# Copie para .env.local e preencha. Nunca faça commit de valores reais.

# Chave da API da Anthropic. Sem ela, "Conferir resposta" responde que a IA está indisponível.
ANTHROPIC_API_KEY=

# Opcional: modelo do Claude. Padrão: claude-haiku-5-5 (rápido e barato).
ANTHROPIC_MODEL=

# Opcional: limite de chamadas à IA por aparelho, por minuto. Padrão: 10.
AI_REQUESTS_PER_MINUTE=

# Opcional: Upstash Redis. Sem isso, as atividades ficam na memória do servidor.
# Na Vercel, configure os dois para que todos os celulares vejam as mesmas atividades.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
